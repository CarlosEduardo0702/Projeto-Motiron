<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>LogMagna • Cadastro de produto</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

  <style>



    :root {
      --bg: #f7f8f4;
      --panel: #ffffff;
      --ink: #1e3328;
      --ink-soft: #5b6b62;
      --green: #244638;
      --green-soft: #e7eedf;
      --line: #dcdfdd;
      --error: #b3261e;
      --side-start: #1e3328;
      --side-end: #2f5a47;

      color-scheme: light;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #131c17;
        --panel: #1b2822;
        --ink: #e9efe9;
        --ink-soft: #9db0a4;
        --green: #8fc3a6;
        --green-soft: #233a2e;
        --line: #2d3e35;
        --error: #ff8a80;
        color-scheme: dark;
      }
    }

    :root[data-theme="dark"] {
      --bg: #131c17;
      --panel: #1b2822;
      --ink: #e9efe9;
      --ink-soft: #9db0a4;
      --green: #8fc3a6;
      --green-soft: #233a2e;
      --line: #2d3e35;
      --error: #ff8a80;
      color-scheme: dark;
    }



    *, *::before, *::after { box-sizing: border-box; }
    html { height: 100%; }

    body {
      display: grid;
      grid-template-columns: 240px 1fr;
      min-height: 100%;
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 400 14px/1.5 Inter, system-ui, Arial, sans-serif;
    }

    h1 { margin: 0; font-size: 26px; letter-spacing: -0.01em; }
    label { font-size: 13px; font-weight: 500; }

    :is(input, select, button, a):focus-visible {
      outline: 2px solid var(--green);
      outline-offset: 2px;
    }



    .sidebar {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      height: 100vh;
      padding: 24px 14px;
      background: linear-gradient(180deg, var(--side-start), var(--side-end));
      color: #e7eedf;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 8px 22px;
      font-size: 18px;
      font-weight: 700;
    }
    .brand svg { width: 26px; height: 26px; }

    .sidebar-title {
      padding: 0 10px 6px;
      font-size: 11px;
      letter-spacing: 0.06em;
      opacity: 0.65;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border-radius: 10px;
      color: inherit;
      font-weight: 500;
      text-decoration: none;
    }
    .menu a svg { flex: none; width: 18px; height: 18px; }
    .menu a:hover { background: rgba(255, 255, 255, 0.08); }
    .menu a[aria-current] { background: rgba(255, 255, 255, 0.14); }

    .help-card {
      margin-top: auto;
      padding: 14px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.1);
      font-size: 13px;
    }
    .help-card b { display: block; margin-bottom: 2px; }

    /* Perfil + menu suspenso */
    .profile { position: relative; margin-top: 0; }

    .profile-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 10px 6px;
      border: 0;
      border-radius: 12px;
      background: none;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .profile-btn:hover { background: rgba(255, 255, 255, 0.08); }
    .profile-btn small { display: block; opacity: 0.7; }

    .avatar {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--green-soft);
      color: #1e3328;
      font-weight: 600;
    }

    .profile-menu {
      position: absolute;
      bottom: calc(100% + 6px);
      left: 0;
      right: 0;
      z-index: 20;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      color: var(--ink);
      box-shadow: 0 12px 32px rgba(11, 28, 48, 0.25);
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    }
    .profile-menu.open { opacity: 1; visibility: visible; transform: none; }

    .profile-menu button {
      display: block;
      width: 100%;
      padding: 9px 10px;
      border: 0;
      border-radius: 8px;
      background: none;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .profile-menu button:hover { background: var(--green-soft); }
    .profile-menu .danger { color: var(--error); }




    .main { min-width: 0; }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 32px;
      background: linear-gradient(90deg, var(--side-end), var(--side-start) 0%, var(--side-end) 55%, #cfd9cf);
      color: #fff;
      font-size: 13px;
    }
    .topbar-status {
      padding: 4px 12px;
      border-radius: 99px;
      background: var(--green-soft);
      color: #1e3328;
      font-weight: 500;
    }

    .page { max-width: 1160px; padding: 28px 32px 40px; }

    .page-head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }
    .page-head p { margin: 4px 0 0; color: var(--ink-soft); }

    .badge {
      padding: 5px 12px;
      border-radius: 99px;
      background: var(--green-soft);
      color: var(--green);
      font-size: 12px;
      font-weight: 600;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
      gap: 20px;
      align-items: start;
    }




    .panel {
      margin-bottom: 20px;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel);
    }
    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .panel-head h2 { margin: 0; font-size: 16px; }
    .panel-head span { color: var(--ink-soft); font-size: 12px; }

    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }

    input, select {
      width: 100%;
      padding: 8px 2px;
      border: 0;
      border-bottom: 1.5px solid var(--line);
      border-radius: 0;
      outline: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
    }
    select { background: var(--panel); }
    input:focus, select:focus { border-bottom-color: var(--green); }

    .error-msg { display: none; color: var(--error); font-size: 12px; }
    .field.invalid .error-msg { display: block; }
    .field.invalid :is(input, select) { border-bottom-color: var(--error); }

    /* Anexo */
    .file-box {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 4px;
      padding: 12px 14px;
      border-radius: 10px;
      background: var(--green-soft);
    }
    .file-box svg { flex: none; width: 22px; height: 22px; color: var(--green); }
    .file-info { flex: 1; min-width: 0; }
    .file-info b {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .file-info small { color: var(--ink-soft); }

    .link-btn {
      border: 0;
      background: none;
      color: var(--green);
      font: inherit;
      font-weight: 600;
      text-decoration: underline;
      cursor: pointer;
    }

    /* Confirmação e ações */
    .consent { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 6px; }
    .consent input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--green); }
    .consent label { font-weight: 400; }
    #consentError { display: none; margin: 0; }

    .actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      margin-top: 16px;
    }

    .btn {
      padding: 11px 20px;
      border: 1.5px solid var(--line);
      border-radius: 10px;
      background: var(--panel);
      color: var(--ink);
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-primary { background: #1e3328; border-color: #1e3328; color: #fff; }
    :root[data-theme="dark"] .btn-primary { background: #8fc3a6; border-color: #8fc3a6; color: #10201a; }



    .summary-tag {
      display: inline-block;
      margin-bottom: 14px;
      padding: 3px 10px;
      border-radius: 99px;
      background: var(--green-soft);
      color: var(--green);
      font-size: 12px;
      font-weight: 600;
    }

    .summary-item {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
    }
    .summary-item small { display: block; color: var(--ink-soft); }

    .summary-icon {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--green-soft);
      color: var(--green);
    }
    .summary-icon svg { width: 20px; height: 20px; }

    .summary-line { display: flex; justify-content: space-between; padding: 4px 0; }
    .summary-line span:first-child { color: var(--ink-soft); }

    .summary-total { margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--line); }
    .summary-total small { color: var(--ink-soft); }
    .summary-total strong { display: block; font-size: 30px; letter-spacing: -0.02em; }

    .notice { padding: 18px; border-radius: 14px; background: var(--green-soft); }
    .notice svg { width: 20px; height: 20px; color: var(--green); }
    .notice b { display: block; margin: 6px 0 4px; }
    .notice p { margin: 0; color: var(--ink-soft); font-size: 13px; }

    .demo-note { margin-top: 6px; color: var(--ink-soft); font-size: 12px; }

    .product-list { margin: 0; padding: 0; list-style: none; }
    .product-list li {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
    }
    .product-list li:last-child { border-bottom: 0; }
    .product-list small { display: block; color: var(--ink-soft); }
    .product-list .remove {
      border: 0;
      background: none;
      color: var(--ink-soft);
      font-size: 12px;
      text-decoration: underline;
      cursor: pointer;
    }
    .empty-text { margin: 0; color: var(--ink-soft); font-size: 13px; }




    #toasts {
      position: fixed;
      top: 64px;
      right: 20px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      overflow: hidden;
      width: 340px;
      max-width: calc(100vw - 40px);
      padding: 14px 14px 18px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel);
      box-shadow: 0 12px 32px rgba(11, 28, 48, 0.18);
      pointer-events: auto;
    }
    .toast-icon {
      display: grid;
      flex: none;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--green-soft);
      color: var(--green);
    }
    .toast-icon svg { width: 20px; height: 20px; }
    .toast b { display: block; }
    .toast-text { color: var(--ink-soft); font-size: 13px; }

    .toast-close {
      margin-left: auto;
      padding: 2px 6px;
      border: 0;
      border-radius: 6px;
      background: none;
      color: var(--ink-soft);
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
    }

    .toast-bar {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 4px;
      background: #91db2a;
      transform-origin: left;
      animation: toast-bar 4s linear forwards;
    }
    .toast:hover .toast-bar { animation-play-state: paused; }

    .toast.error .toast-icon { background: #ffdad6; color: #ba1a1a; }
    .toast.error .toast-bar { background: #ba1a1a; }

    @keyframes toast-bar { to { transform: scaleX(0); } }
    @keyframes toast-in { from { opacity: 0; transform: translateX(50px); } }



    @media (prefers-reduced-motion: no-preference) {
      input, select { transition: border-color 0.15s; }
      .toast { animation: toast-in 0.3s ease; }
    }

    @media (max-width: 900px) {
      body { grid-template-columns: 1fr; }

      .sidebar {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        height: auto;
        padding: 12px;
      }
      .brand { padding: 0 8px; }
      .sidebar-title, .help-card, .profile { display: none; }
      .menu { display: flex; flex-wrap: wrap; gap: 2px; }

      .topbar { padding: 12px 16px; }
      .page { padding: 20px 16px; }
      .layout { grid-template-columns: 1fr; }
      .row { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>


  <aside class="sidebar">
    <div class="brand">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/>
        <path d="M2 21c0-3 1.9-5.5 5-7"/>
      </svg>
      LogMagna
    </div>

    <div class="sidebar-title">ÁREA DO CLIENTE</div>

    <nav class="menu">
      <a href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/>
          <rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>
        </svg>
        Visão geral
      </a>
      <a href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
          <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>
        </svg>
        Serviços contratados
      </a>
      <a href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/>
          <path d="M8 19h8a3 3 0 0 0 0-6H8a3 3 0 0 1 0-6h8"/>
        </svg>
        Rastrear encomenda
      </a>
      <a href="#" aria-current="page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>
        </svg>
        Cadastrar produto
      </a>
    </nav>

    <div class="help-card">
      <b>Tudo em um só lugar.</b>
      Organize suas compras e acompanhe cada entrega.
    </div>

    <div class="profile" id="profile">
      <div class="profile-menu" id="profileMenu" role="menu">
        <button type="button" role="menuitem" data-label="Meu perfil">Meu perfil</button>
        <button type="button" role="menuitem" data-label="Configurações">Configurações</button>
        <button type="button" role="menuitem" data-label="Central de ajuda">Central de ajuda</button>
        <button type="button" role="menuitem" class="danger" data-label="Sair">Sair</button>
      </div>
      <button type="button" class="profile-btn" id="profileBtn" aria-haspopup="true" aria-expanded="false">
        <div class="avatar">AS</div>
        <div>Ana Silva<small>Conta demonstrativa</small></div>
      </button>
    </div>
  </aside>



  <div class="main">
    <div class="topbar">
      <span>Área do cliente &nbsp;/&nbsp; Cadastrar produto</span>
      <span class="topbar-status">Ambiente de demonstração</span>
    </div>

    <div class="page">
      <div class="page-head">
        <div>
          <h1>Cadastrar novo produto</h1>
          <p>Preencha os dados da compra e revise o resumo demonstrativo.</p>
        </div>
        <span class="badge">Rascunho • não cadastrado</span>
      </div>

      <div class="layout">

        <form id="form" novalidate>

          <section class="panel">
            <div class="panel-head"><h2>Dados do produto</h2><span>* Obrigatórios</span></div>

            <div class="field">
              <label for="nome">Nome do produto *</label>
              <input id="nome" placeholder="Ex.: Mouse Logitech MX Master 3S">
              <span class="error-msg">Informe o nome do produto.</span>
            </div>

            <div class="row">
              <div class="field">
                <label for="cat">Categoria *</label>
                <select id="cat">
                  <option value="">Selecione</option>
                  <option>Eletrônicos</option>
                  <option>Casa e decoração</option>
                  <option>Moda e acessórios</option>
                  <option>Livros e papelaria</option>
                  <option>Esporte e lazer</option>
                  <option>Outros</option>
                </select>
                <span class="error-msg">Escolha uma categoria.</span>
              </div>
              <div class="field">
                <label for="valor">Valor da compra *</label>
                <input id="valor" inputmode="numeric" placeholder="R$ 0,00">
                <span class="error-msg">Informe um valor maior que zero.</span>
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="loja">Loja / vendedor *</label>
                <input id="loja" placeholder="Ex.: Loja Exemplo">
                <span class="error-msg">Informe a loja ou o vendedor.</span>
              </div>
              <div class="field">
                <label for="data">Data da compra *</label>
                <input id="data" type="date">
                <span class="error-msg">Informe uma data que não seja futura.</span>
              </div>
            </div>
          </section>

          <section class="panel">
            <div class="panel-head"><h2>Informações de envio</h2></div>

            <div class="row">
              <div class="field">
                <label for="transp">Transportadora *</label>
                <select id="transp">
                  <option value="">Selecione</option>
                  <option>Correios (demo)</option>
                  <option>Jadlog (demo)</option>
                  <option>Loggi (demo)</option>
                  <option>Outra (demo)</option>
                </select>
                <span class="error-msg">Escolha a transportadora.</span>
              </div>
              <div class="field">
                <label for="rastreio">Código de rastreio (opcional)</label>
                <input id="rastreio" placeholder="Ainda não informado" autocapitalize="characters">
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="cep">CEP de destino *</label>
                <input id="cep" inputmode="numeric" placeholder="00000-000" maxlength="9">
                <span class="error-msg">Digite um CEP com 8 números.</span>
              </div>
              <div class="field">
                <label for="cidade">Cidade / UF *</label>
                <input id="cidade" placeholder="São Paulo / SP">
                <span class="error-msg">Informe a cidade e o estado.</span>
              </div>
            </div>

            <label>Comprovante da compra (opcional)</label>
            <div class="file-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>
              </svg>
              <div class="file-info">
                <b id="fileName">Nenhum arquivo anexado</b>
                <small id="fileSize">PDF, JPG ou PNG • o arquivo não sai do seu navegador</small>
              </div>
              <button type="button" class="link-btn" id="filePick">Anexar</button>
              <input type="file" id="file" accept=".pdf,image/*" hidden>
            </div>
          </section>

          <section class="panel">
            <div class="consent">
              <input type="checkbox" id="consent">
              <label for="consent">Estou ciente de que este cadastro é demonstrativo e não gera contratação, cobrança ou cobertura de seguro real.</label>
            </div>
            <div class="field invalid" id="consentError">
              <span class="error-msg">Marque a ciência para cadastrar o produto.</span>
            </div>

            <div class="actions">
              <button type="button" class="btn" id="cancel">Cancelar</button>
              <button type="submit" class="btn btn-primary">Cadastrar produto (demo)</button>
            </div>
          </section>
        </form>


        <div>
          <section class="panel">
            <div class="panel-head"><h2>Resumo do cadastro</h2></div>
            <span class="summary-tag">Seguro de encomenda • demo</span>

            <div class="summary-item">
              <div class="summary-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>
                </svg>
              </div>
              <div><b id="sumName">Produto sem nome</b><small id="sumCategory">Categoria não escolhida</small></div>
            </div>

            <div class="summary-line"><span>Valor do produto</span><span id="sumValue">R$ 0,00</span></div>
            <div class="summary-line"><span>Taxa ilustrativa</span><span>2% por envio</span></div>
            <div class="summary-line"><span>Destino</span><span id="sumDest">—</span></div>

            <div class="summary-total">
              <small>Total</small>
              <strong id="sumTotal">R$ 0,00</strong>
              <small>Custo simulado deste envio</small>
            </div>
          </section>

          <section class="notice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
            </svg>
            <b>Revise com tranquilidade.</b>
            <p>Este produto ainda não faz parte dos seus 3 serviços ativos. O resumo é apenas uma prévia e não altera os valores do painel.</p>
          </section>

          <section class="panel" style="margin-top: 20px;">
            <div class="panel-head"><h2>Produtos cadastrados</h2><span id="listCount">0</span></div>
            <p class="empty-text" id="listEmpty">Nenhum produto cadastrado ainda. Preencha o formulário para começar.</p>
            <ul class="product-list" id="productList"></ul>
          </section>

          <p class="demo-note">Protótipo estático • Dados e valores fictícios. Nenhuma contratação ou cobertura de seguro real.</p>
        </div>

      </div>
    </div>
  </div>

  <div id="toasts" aria-live="polite"></div>

  <script>

    const $ = (id) => document.getElementById(id);

    const formatBRL = (n) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

    const escapeHTML = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const TAXA = 0.02;          // taxa ilustrativa por envio
    const FILE_HINT = 'PDF, JPG ou PNG • o arquivo não sai do seu navegador';

    let valueInCents = 0;       // valor digitado, em centavos
    const products = [];        // produtos cadastrados (somente em memória)

    $('data').max = new Date().toISOString().slice(0, 10);


  
    const TOAST_ICONS = {
      success: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
      info:    '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
      error:   '<path d="M12 8v5M12 16h.01"/><circle cx="12" cy="12" r="9"/>',
    };

    function showToast(title, text = '', type = 'success') {
      const toast = document.createElement('div');
      toast.className = 'toast' + (type === 'error' ? ' error' : '');
      toast.setAttribute('role', 'status');
      toast.innerHTML = `
        <div class="toast-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${TOAST_ICONS[type]}</svg>
        </div>
        <div>
          <b>${escapeHTML(title)}</b>
          ${text ? `<span class="toast-text">${escapeHTML(text)}</span>` : ''}
        </div>
        <button type="button" class="toast-close" aria-label="Fechar">×</button>
        <div class="toast-bar"></div>`;

      const remove = () => toast.remove();
      toast.querySelector('.toast-close').addEventListener('click', remove);
      toast.querySelector('.toast-bar').addEventListener('animationend', remove);
      $('toasts').appendChild(toast);
    }


 
    function renderSummary() {
      const value = valueInCents / 100;
      $('sumName').textContent     = $('nome').value.trim() || 'Produto sem nome';
      $('sumCategory').textContent = $('cat').value || 'Categoria não escolhida';
      $('sumValue').textContent    = formatBRL(value);
      $('sumTotal').textContent    = formatBRL(value * (1 + TAXA));
      $('sumDest').textContent     = $('cidade').value.trim().replace(/\s*\/\s*/, ', ') || '—';
    }

    ['nome', 'cat', 'cidade'].forEach((id) => $(id).addEventListener('input', renderSummary));


  
    $('valor').addEventListener('input', (e) => {
      valueInCents = parseInt(e.target.value.replace(/\D/g, '') || '0', 10);
      e.target.value = valueInCents ? formatBRL(valueInCents / 100) : '';
      renderSummary();
    });

    $('cep').addEventListener('input', (e) => {
      const digits = e.target.value.replace(/\D/g, '').slice(0, 8);
      e.target.value = digits.length > 5 ? `${digits.slice(0, 5)}-${digits.slice(5)}` : digits;
    });

    $('filePick').addEventListener('click', () => $('file').click());

    $('file').addEventListener('change', (e) => {
      const file = e.target.files[0];
      $('fileName').textContent = file ? file.name : 'Nenhum arquivo anexado';
      $('fileSize').textContent = file ? `${Math.max(1, Math.round(file.size / 1024))} KB • arquivo anexado` : FILE_HINT;
      $('filePick').textContent = file ? 'Trocar' : 'Anexar';
    });


 
    const rules = {
      nome:   (v) => v.trim().length > 1,
      cat:    (v) => !!v,
      valor:  ()  => valueInCents > 0,
      loja:   (v) => v.trim().length > 1,
      data:   (v) => !!v && v <= $('data').max,
      transp: (v) => !!v,
      cep:    (v) => v.replace(/\D/g, '').length === 8,
      cidade: (v) => v.trim().length > 1,
    };

    function validateField(id) {
      const valid = rules[id]($(id).value);
      $(id).closest('.field').classList.toggle('invalid', !valid);
      return valid;
    }

    Object.keys(rules).forEach((id) => $(id).addEventListener('blur', () => validateField(id)));


    function renderProducts() {
      $('listCount').textContent = products.length;
      $('listEmpty').style.display = products.length ? 'none' : 'block';

      $('productList').innerHTML = products.map((p) => `
        <li>
          <div><b>${escapeHTML(p.name)}</b><small>${escapeHTML(p.category)} • ${escapeHTML(p.destination)}</small></div>
          <div style="text-align: right;">
            ${formatBRL(p.value)}<br>
            <button type="button" class="remove" data-id="${p.id}">Remover</button>
          </div>
        </li>`).join('');
    }

    $('productList').addEventListener('click', (e) => {
      const button = e.target.closest('.remove');
      if (!button) return;

      const index = products.findIndex((p) => String(p.id) === button.dataset.id);
      if (index === -1) return;

      const [removed] = products.splice(index, 1);
      renderProducts();
      showToast('Produto removido', `${removed.name} saiu da lista.`, 'info');
    });


  
    function resetForm() {
      $('form').reset();
      valueInCents = 0;
      $('fileName').textContent = 'Nenhum arquivo anexado';
      $('fileSize').textContent = FILE_HINT;
      $('filePick').textContent = 'Anexar';
      document.querySelectorAll('.field.invalid').forEach((f) => f.classList.remove('invalid'));
      $('consentError').style.display = 'none';
      renderSummary();
    }

    $('form').addEventListener('submit', (e) => {
      e.preventDefault();

      const fieldsOk  = Object.keys(rules).map(validateField).every(Boolean);
      const consentOk = $('consent').checked;
      $('consentError').style.display = consentOk ? 'none' : 'block';

      if (!fieldsOk || !consentOk) {
        document.querySelector('.field.invalid input, .field.invalid select')?.focus();
        showToast('Revise os campos', 'Alguns campos obrigatórios precisam de atenção.', 'error');
        return;
      }

      const name = $('nome').value.trim();
      products.unshift({
        id: Date.now(),
        name,
        category: $('cat').value,
        value: valueInCents / 100,
        destination: $('cidade').value.trim(),
      });

      renderProducts();
      resetForm();
      showToast('Produto cadastrado!', `${name} foi adicionado à lista da demonstração.`);
    });

    $('cancel').addEventListener('click', () => {
      resetForm();
      showToast('Rascunho descartado', 'Os campos foram limpos.', 'info');
    });


   
    function toggleProfileMenu(open) {
      $('profileMenu').classList.toggle('open', open);
      $('profileBtn').setAttribute('aria-expanded', open);
    }

    $('profileBtn').addEventListener('click', (e) => {
      e.stopPropagation();
      toggleProfileMenu(!$('profileMenu').classList.contains('open'));
    });

    $('profileMenu').addEventListener('click', (e) => {
      const item = e.target.closest('[data-label]');
      if (!item) return;
      toggleProfileMenu(false);
      showToast(item.dataset.label, 'Esta ação é apenas ilustrativa na demonstração.', 'info');
    });

    document.addEventListener('click', (e) => {
      if (!$('profile').contains(e.target)) toggleProfileMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleProfileMenu(false);
    });

    document.querySelectorAll('.menu a:not([aria-current])').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        showToast(link.textContent.trim(), 'Esta tela não faz parte do protótipo de cadastro.', 'info');
      });
    });


    renderSummary();
    renderProducts();
  </script>
</body>
</html>
