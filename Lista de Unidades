        </button>
      </div>

      <form id="documentForm" class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
        <label class="md:col-span-2 flex flex-col gap-1">
          <span class="font-label-md text-label-md">Nome do documento</span>
          <input id="docNome" required placeholder="Ex.: Licença Ambiental" class="h-10 px-3 bg-surface-container-low rounded-lg" />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Código</span>
          <input id="docCodigo" required placeholder="DOC-001" class="h-10 px-3 bg-surface-container-low rounded-lg" />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Órgão</span>
          <input id="docOrgao" required placeholder="Órgão emissor" class="h-10 px-3 bg-surface-container-low rounded-lg" />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Unidade</span>
          <select id="docUnidade" class="h-10 px-3 bg-surface-container-low rounded-lg">
            <option>Recife</option>
            <option>Olinda</option>
            <option>Jaboatão</option>
            <option>Caruaru</option>
            <option>Petrolina</option>
          </select>
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Categoria</span>
          <select id="docCategoria" class="h-10 px-3 bg-surface-container-low rounded-lg">
            <option>Alvarás</option>
            <option>Licenças Ambientais</option>
            <option>Seguros</option>
            <option>Contratos</option>
            <option>Laudos Técnicos</option>
          </select>
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Data de cadastro</span>
          <input id="docCadastro" type="date" required class="h-10 px-3 bg-surface-container-low rounded-lg" />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-label-md text-label-md">Validade</span>
          <input id="docValidade" type="date" required class="h-10 px-3 bg-surface-container-low rounded-lg" />
        </label>

        <div class="md:col-span-2 flex justify-end gap-2 mt-2">
          <button id="cancelModalBtn" type="button" class="h-10 px-4 rounded-lg bg-surface-container">Cancelar</button>
          <button type="submit" class="h-10 px-4 rounded-lg bg-secondary-fixed text-on-secondary-fixed font-bold">Cadastrar documento</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================== LÓGICA DA PÁGINA ===================== -->
  <script>
    /* ---------- Dados ---------- */
    // Em produção isso viria de uma API; aqui é uma lista em memória.
    const documentos = [
      { id: 1,  nome: 'Alvará Sanitário e Municipal',                              codigo: 'ALV-REC-2024',    orgao: 'Prefeitura do Recife',   unidade: 'Recife',    categoria: 'Alvarás',              cadastro: '10/01/2024', validade: '15/12/2026' },
      { id: 2,  nome: 'AVCB - Auto de Vistoria do Corpo de Bombeiros',              codigo: 'AVCB-OLI-2024',   orgao: 'Corpo de Bombeiros PE',   unidade: 'Olinda',    categoria: 'Laudos Técnicos',      cadastro: '12/02/2024', validade: '25/10/2026' },
      { id: 3,  nome: 'Licença Ambiental de Operação',                             codigo: 'LAO-PET-2025',    orgao: 'CPRH',                    unidade: 'Petrolina', categoria: 'Licenças Ambientais',  cadastro: '01/05/2025', validade: '01/10/2026' },
      { id: 4,  nome: 'Apólice de Seguro Patrimonial e Responsabilidade Civil',     codigo: 'PORTO-SEG-9091',  orgao: 'Porto Seguro Cia',        unidade: 'Jaboatão',  categoria: 'Seguros',              cadastro: '15/02/2026', validade: '15/02/2027' },
      { id: 5,  nome: 'Contrato de Manutenção de Climatização',                    codigo: 'CTR-2024-041',    orgao: 'TermoTech Engenharia',    unidade: 'Caruaru',   categoria: 'Contratos',            cadastro: '01/08/2026', validade: '30/08/2027' },
      { id: 6,  nome: 'Habite-se e Certidão de Regularidade Predial',              codigo: 'HAB-REC-2022',    orgao: 'Prefeitura do Recife',    unidade: 'Recife',    categoria: 'Alvarás',              cadastro: '20/09/2022', validade: '20/09/2027' },
      { id: 7,  nome: 'Licença de Operação de Transporte',                         codigo: 'LOT-JAB-2026',    orgao: 'Órgão Estadual',          unidade: 'Jaboatão',  categoria: 'Licenças Ambientais',  cadastro: '05/03/2026', validade: '05/03/2027' },
      { id: 8,  nome: 'Contrato de Locação do Galpão',                             codigo: 'CTR-OLI-118',     orgao: 'Moovere',                 unidade: 'Olinda',    categoria: 'Contratos',            cadastro: '18/01/2026', validade: '18/01/2028' },
      { id: 9,  nome: 'Laudo de Segurança Elétrica',                               codigo: 'LSE-CAR-026',     orgao: 'SegTech',                 unidade: 'Caruaru',   categoria: 'Laudos Técnicos',      cadastro: '11/04/2026', validade: '11/04/2027' },
      { id: 10, nome: 'Seguro de Frota',                                           codigo: 'SEG-FRO-777',     orgao: 'Seguradora Nacional',     unidade: 'Petrolina', categoria: 'Seguros',              cadastro: '22/01/2026', validade: '22/01/2027' },
      { id: 11, nome: 'Licença Ambiental do Galpão',                               codigo: 'LAG-REC-010',     orgao: 'CPRH',                    unidade: 'Recife',    categoria: 'Licenças Ambientais',  cadastro: '03/02/2026', validade: '03/02/2027' },
      { id: 12, nome: 'Alvará de Funcionamento',                                   codigo: 'ALV-CAR-091',     orgao: 'Prefeitura de Caruaru',   unidade: 'Caruaru',   categoria: 'Alvarás',              cadastro: '09/01/2025', validade: '09/09/2026' },
    ];

    /* ---------- Estado ---------- */
    const ITENS_POR_PAGINA = 6;
    let paginaAtual = 1;

    /* ---------- Referências de elementos ---------- */
    const tabelaBody       = document.getElementById('documentsBody');
    const inputBusca       = document.getElementById('searchInput');
    const selectUnidade    = document.getElementById('filterUnidade');
    const selectStatus     = document.getElementById('filterStatus');
    const selectCategoria  = document.getElementById('filterCategoria');
    const paginationInfo   = document.getElementById('paginationInfo');
    const paginationCtrls  = document.getElementById('paginationControls');
    const modal            = document.getElementById('documentModal');
    const formNovoDoc      = document.getElementById('documentForm');

    /* ---------- Utilidades de data / status ---------- */

    // Converte "dd/mm/aaaa" em um objeto Date.
    function parseDataBR(data) {
      const [dia, mes, ano] = data.split('/').map(Number);
      return new Date(ano, mes - 1, dia);
    }

    // Calcula o status de um documento a partir da validade.
    function getStatusDocumento(doc) {
      const hoje = new Date();
      hoje.setHours(0, 0, 0, 0);

      const validade = parseDataBR(doc.validade);
      const diasRestantes = Math.ceil((validade - hoje) / 86_400_000);

      if (diasRestantes < 0) {
        return { texto: 'Vencido', classe: 'bg-error-container text-on-error-container', dias: diasRestantes };
      }
      if (diasRestantes <= 60) {
        return { texto: 'Próximo do vencimento', classe: 'bg-secondary-fixed/30 text-on-secondary-fixed-variant', dias: diasRestantes };
      }
      return { texto: 'Válido', classe: 'bg-secondary-fixed/30 text-on-secondary-fixed-variant', dias: diasRestantes };
    }

    /* ---------- Filtros ---------- */

    function aplicarFiltros() {
      const termo = inputBusca.value.toLowerCase().trim();

      return documentos.filter((doc) => {
        const status = getStatusDocumento(doc).texto;
        const textoBusca = [doc.nome, doc.codigo, doc.orgao, doc.unidade, doc.categoria]
          .join(' ')
          .toLowerCase();

        const passaBusca     = !termo || textoBusca.includes(termo);
        const passaUnidade   = !selectUnidade.value || doc.unidade === selectUnidade.value;
        const passaStatus    = !selectStatus.value || status === selectStatus.value;
        const passaCategoria = !selectCategoria.value || doc.categoria === selectCategoria.value;

        return passaBusca && passaUnidade && passaStatus && passaCategoria;
      });
    }

    /* ---------- Renderização da tabela ---------- */

    function criarLinhaTabela(doc) {
      const status = getStatusDocumento(doc);
      const diasTexto = status.dias < 0
        ? `Vencido há ${Math.abs(status.dias)} dias`
        : `${status.dias} dias restantes`;

      return `
        <tr class="h-[64px] hover:bg-surface-container-low/60 transition-colors">
          <td class="px-space-md">
            <div class="flex items-center gap-space-sm">
              <div class="w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-[20px]">description</span>
              </div>
              <div class="min-w-0">
                <p class="font-title-md text-title-md text-on-surface font-semibold truncate">${doc.nome}</p>
                <p class="font-body-sm text-body-sm text-outline">${doc.codigo} • ${doc.orgao}</p>
              </div>
            </div>
          </td>
          <td class="px-space-md whitespace-nowrap">
            <span class="inline-flex items-center gap-1 font-body-md text-on-surface">
              <span class="material-symbols-outlined text-[16px] text-outline">location_on</span>${doc.unidade}
            </span>
          </td>
          <td class="px-space-md whitespace-nowrap">
            <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface text-label-sm font-label-sm">${doc.categoria}</span>
          </td>
          <td class="px-space-md whitespace-nowrap text-on-surface-variant font-body-sm text-body-sm">${doc.cadastro}</td>
          <td class="px-space-md whitespace-nowrap">
            <div class="flex flex-col">
              <span class="font-title-md text-title-md text-on-surface">${doc.validade}</span>
              <span class="font-body-sm text-body-sm text-outline">${diasTexto}</span>
            </div>
          </td>
          <td class="px-space-md whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full ${status.classe} text-label-sm font-label-sm font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>${status.texto}
            </span>
          </td>
          <td class="px-space-md whitespace-nowrap text-right">
            <div class="flex items-center justify-end gap-1 text-on-surface-variant">
              <button type="button" title="Baixar Arquivo" onclick="baixarDocumento(${doc.id})" class="p-1.5 hover:text-primary hover:bg-surface-container rounded-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">download</span>
              </button>
              <button type="button" title="Visualizar" onclick="visualizarDocumento(${doc.id})" class="p-1.5 hover:text-primary hover:bg-surface-container rounded-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">visibility</span>
              </button>
              <button type="button" title="Mais opções" onclick="maisOpcoes(${doc.id})" class="p-1.5 hover:text-primary hover:bg-surface-container rounded-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">more_vert</span>
              </button>
            </div>
          </td>
        </tr>
      `;
    }

    function renderizarPaginacao(totalPaginas) {
      paginationCtrls.innerHTML = '';

      const botaoAnterior = document.createElement('button');
      botaoAnterior.className = 'w-8 h-8 rounded-lg flex items-center justify-center hover:bg-surface-container';
      botaoAnterior.innerHTML = '<span class="material-symbols-outlined text-[18px]">chevron_left</span>';
      botaoAnterior.disabled = paginaAtual === 1;
      botaoAnterior.onclick = () => { paginaAtual--; renderizarTabela(); };
      paginationCtrls.appendChild(botaoAnterior);

      for (let pagina = 1; pagina <= totalPaginas; pagina++) {
        const botaoPagina = document.createElement('button');
        botaoPagina.textContent = pagina;
        botaoPagina.className = 'w-8 h-8 rounded-lg flex items-center justify-center font-label-md ' +
          (pagina === paginaAtual
            ? 'bg-primary text-on-primary font-bold'
            : 'text-on-surface hover:bg-surface-container');
        botaoPagina.onclick = () => { paginaAtual = pagina; renderizarTabela(); };
        paginationCtrls.appendChild(botaoPagina);
      }

      const botaoProximo = document.createElement('button');
      botaoProximo.className = 'w-8 h-8 rounded-lg flex items-center justify-center hover:bg-surface-container';
      botaoProximo.innerHTML = '<span class="material-symbols-outlined text-[18px]">chevron_right</span>';
      botaoProximo.disabled = paginaAtual === totalPaginas;
      botaoProximo.onclick = () => { paginaAtual++; renderizarTabela(); };
      paginationCtrls.appendChild(botaoProximo);
    }

    function renderizarTabela() {
      const listaFiltrada = aplicarFiltros();
      const totalPaginas = Math.max(1, Math.ceil(listaFiltrada.length / ITENS_POR_PAGINA));

      if (paginaAtual > totalPaginas) paginaAtual = totalPaginas;

      const indiceInicial = (paginaAtual - 1) * ITENS_POR_PAGINA;
      const itensDaPagina = listaFiltrada.slice(indiceInicial, indiceInicial + ITENS_POR_PAGINA);

      tabelaBody.innerHTML = itensDaPagina.map(criarLinhaTabela).join('');

      paginationInfo.textContent = listaFiltrada.length
        ? `Mostrando ${indiceInicial + 1} a ${Math.min(indiceInicial + ITENS_POR_PAGINA, listaFiltrada.length)} de ${listaFiltrada.length} documentos`
        : 'Nenhum documento encontrado';

      renderizarPaginacao(totalPaginas);
    }

    function atualizarListaComFiltros() {
      paginaAtual = 1;
      renderizarTabela();
    }

    /* ---------- Ações por documento ---------- */

    function visualizarDocumento(id) {
      const doc = documentos.find((d) => d.id === id);
      const status = getStatusDocumento(doc);

      alert(
        `DOCUMENTO\n\n` +
        `${doc.nome}\n` +
        `Código: ${doc.codigo}\n` +
        `Órgão: ${doc.orgao}\n` +
        `Unidade: ${doc.unidade}\n` +
        `Categoria: ${doc.categoria}\n` +
        `Cadastro: ${doc.cadastro}\n` +
        `Validade: ${doc.validade}\n` +
        `Status: ${status.texto}`
      );
    }

    function baixarDocumento(id) {
      const doc = documentos.find((d) => d.id === id);
      const conteudo =
        `Moovere - Documento\n` +
        `Nome: ${doc.nome}\n` +
        `Código: ${doc.codigo}\n` +
        `Órgão: ${doc.orgao}\n` +
        `Unidade: ${doc.unidade}\n` +
        `Categoria: ${doc.categoria}\n` +
        `Cadastro: ${doc.cadastro}\n` +
        `Validade: ${doc.validade}\n` +
        `Status: ${getStatusDocumento(doc).texto}`;

      const blob = new Blob([conteudo], { type: 'text/plain' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `${doc.codigo}.txt`;
      link.click();
      URL.revokeObjectURL(link.href);
    }

    function maisOpcoes(id) {
      const doc = documentos.find((d) => d.id === id);
      const confirmarExclusao = confirm(`Documento: ${doc.nome}\n\nDeseja excluir este documento?`);

      if (confirmarExclusao) {
        const indice = documentos.findIndex((d) => d.id === id);
        documentos.splice(indice, 1);
        renderizarTabela();
      }
    }

    /* ---------- Modal "Novo Documento" ---------- */

    function abrirModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.getElementById('docCadastro').value = new Date().toISOString().slice(0, 10);
    }

    function fecharModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function converterDataParaBR(dataISO) {
      // "aaaa-mm-dd" -> "dd/mm/aaaa"
      return dataISO.split('-').reverse().join('/');
    }

    function cadastrarNovoDocumento(evento) {
      evento.preventDefault();

      documentos.unshift({
        id: Date.now(),
        nome: document.getElementById('docNome').value,
        codigo: document.getElementById('docCodigo').value,
        orgao: document.getElementById('docOrgao').value,
        unidade: document.getElementById('docUnidade').value,
        categoria: document.getElementById('docCategoria').value,
        cadastro: converterDataParaBR(document.getElementById('docCadastro').value),
        validade: converterDataParaBR(document.getElementById('docValidade').value),
      });

      formNovoDoc.reset();
      fecharModal();
      atualizarListaComFiltros();
      alert('Documento cadastrado com sucesso!');
    }

    /* ---------- Event listeners ---------- */

    inputBusca.addEventListener('input', atualizarListaComFiltros);
    selectUnidade.addEventListener('change', atualizarListaComFiltros);
    selectStatus.addEventListener('change', atualizarListaComFiltros);
    selectCategoria.addEventListener('change', atualizarListaComFiltros);

    document.getElementById('newDocumentBtn').addEventListener('click', abrirModal);
    document.getElementById('closeModalBtn').addEventListener('click', fecharModal);
    document.getElementById('cancelModalBtn').addEventListener('click', fecharModal);
    modal.addEventListener('click', (evento) => { if (evento.target === modal) fecharModal(); });
    formNovoDoc.addEventListener('submit', cadastrarNovoDocumento);

    /* ---------- Inicialização ---------- */
    renderizarTabela();
  </script>
</body>
</html>
